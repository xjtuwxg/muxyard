{
  "name": "muxyard",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop home for your existing tmux sessions and coding agents.",
  "author": {
    "name": "Muxyard contributors",
    "email": "2418907+xjtuwxg@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "icon": "node scripts/generate-icon.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "test:ui": "playwright test",
    "dist:mac": "npm run build && electron-builder --mac --dir --publish never",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac:installers": "npm run dist -- --mac",
    "dist:win": "npm run dist -- --win --x64",
    "dist:linux": "npm run dist -- --linux --x64",
    "site:build": "npm run build --prefix website",
    "site:preview": "npm run preview --prefix website",
    "site:test": "npm run test:unit --prefix website && npm test --prefix website",
    "screenshots": "npm run build && node scripts/capture-website.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "prettier": "^3.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "dev.muxyard.desktop",
    "productName": "Muxyard",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "mac": {
      "identity": "-",
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "artifactName": "Muxyard-${version}-${os}-${arch}.${ext}",
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xjtuwxg/muxyard.git"
  },
  "homepage": "https://xiaoguang.wang/muxyard/",
  "bugs": {
    "url": "https://github.com/xjtuwxg/muxyard/issues"
  }
}
